.venv/
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# The source data remains outside Git and is referenced by configuration.
data/raw/*
data/interim/*
data/processed/*

# Generated experiment outputs can be large and are rebuilt from code.
results/runs/*
results/figures/*

# Keep directory documentation in the repository.
!data/raw/README.md
!data/interim/README.md
!data/processed/README.md
!results/README.md
